<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only: lets adb push a synthetic signal through the real pipeline. -->
        <receiver
            android:name="com.mati.tradenotify.debug.DebugInjectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mati.tradenotify.DEBUG_INJECT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
